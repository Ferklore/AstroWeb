---
const pageTitle = "Mi blog con kegovc";
import { getCollection } from "astro:content";
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogPost from '../components/BlogPost.astro';
const allPosts = await getCollection("blog");
---

<BaseLayout pageTitle={pageTitle}>
  <h2>Mi blog de Astro</h2>

  <p>Listo porfe, hice esta practica por mi cuenta btw</p>

  <h3>Posts</h3>
  <ul class="posts">
    {
      allPosts.map((post) => (
        <BlogPost url={`/posts/${post.id}/`} title={post.data.title} />
      ))
    }
  </ul>

  <p class="nota">Próximamente: Wattpad de kegov x Isaac</p>
</BaseLayout>

<style>
  .posts {
    list-style: none;
    padding: 0;
  }

  /* :global porque los li y a vienen del componente BlogPost */
  .posts :global(li) {
    background-color: var(--tarjeta);
    border-left: 5px solid var(--naranja);
    margin-bottom: 0.6rem;
  }

  .posts :global(a) {
    display: block;
    padding: 0.7rem 1rem;
    color: var(--texto);
    text-decoration: none;
  }

  .posts :global(li:hover) {
    background-color: var(--naranja);
  }

  .posts :global(li:hover a) {
    color: white;
  }

  .nota {
    margin-top: 2rem;
    opacity: 0.7;
  }
</style>