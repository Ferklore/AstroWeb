---
import BaseLayout from '../layouts/BaseLayout.astro';
const pageTitle = "Sobre mí";

const identity = {
  firstName: "Fernao",
  country: "México",
  occupation: "estudiante del ceti (ya casi no)",
  hobbies: ["cantar", "el box", "escribir"],
};

const skills = ["HTML", "CSS", "JavaScript", "React", "Astro", "C++", "Godot"];

const happy = true;
const finished = true;
const goal = 3;

const skillColor = "#f99e1a";
const fontWeight = "bold";
const textCase = "uppercase";
---

<BaseLayout pageTitle={pageTitle}>
  <h2>... y mi nuevo sitio en Astro</h2>

  <p>Estoy haciendo el tutorial de Astro. Esta es la segunda página del sitio y la primera que hice yo solo.</p>

  <p>Unos datos sobre mí:</p>

  <ul>
    <li>Me llamo {identity.firstName}.</li>
    <li>Vivo en {identity.country} y soy {identity.occupation}.</li>
    {identity.hobbies.length >= 2 &&
      <li>Dos de mis hobbies son {identity.hobbies[0]} y {identity.hobbies[1]}, pero también me gusta {identity.hobbies[2]}.</li>
    }
  </ul>

  <h3>Mis habilidades</h3>

  <ul class="skills">
    {skills.map((skill) => <li class="skill">{skill}</li>)}
  </ul>

  {happy && <p>¡Me la estoy pasando bien aprendiendo Astro!</p>}

  {finished && <p>¡Terminé el tutorial!</p>}

  {goal === 3 ? <p>Mi meta es terminar el ceti .</p> : <p> no terminé el ceti .</p>}
</BaseLayout>

<style define:vars={{ skillColor, fontWeight, textCase }}>
  .skills {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .skill {
    padding: 0.3rem 0.9rem;
    background-color: var(--tarjeta);
    border-left: 4px solid var(--skillColor);
    font-weight: var(--fontWeight);
    text-transform: var(--textCase);
  }
</style>